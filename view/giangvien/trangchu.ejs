<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Giáo viên chủ nhiệm
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <style>

        /* ==================================================
           CHUNG
        ================================================== */

        * {
            box-sizing: border-box;
        }


        html,
        body,
        button,
        a {

            font-family:
                "Segoe UI",
                Tahoma,
                Arial,
                sans-serif !important;
        }


        body {

            margin: 0;

            background: #f4f6f9;

            color: #172033;

            font-size: 16px;
        }


        .teacher-page {

            min-height: 100vh;
        }


        .teacher-container {

            width: min(
                1180px,
                calc(100% - 40px)
            );

            margin: 0 auto;

            padding:
                28px
                0
                60px;
        }


        /* ==================================================
           HEADER
        ================================================== */

        .teacher-header {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            gap: 20px;

            margin-bottom: 24px;
        }


        .teacher-header-text h1 {

            margin:
                0
                0
                5px;

            font-size: 27px;

            line-height: 1.3;

            font-weight: 700;

            color: #111827;
        }


        .teacher-header-text p {

            margin: 0;

            color: #697586;

            font-size: 15px;
        }


        .logout-button {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-height: 42px;

            padding:
                10px
                18px;

            border-radius: 9px;

            background: #df3545;

            color: #ffffff;

            text-decoration: none;

            font-weight: 600;

            white-space: nowrap;

            transition: 0.2s;
        }


        .logout-button:hover {

            background: #c82d3c;
        }


        /* ==================================================
           CARD CHUNG
        ================================================== */

        .section-card {

            background: #ffffff;

            border:
                1px solid
                #e0e6ed;

            border-radius: 16px;

            padding:
                24px;

            margin-bottom: 22px;
        }


        .section-title {

            margin:
                0
                0
                5px;

            font-size: 20px;

            font-weight: 700;

            color: #172033;
        }


        .section-description {

            margin:
                0
                0
                20px;

            color: #707b8d;

            font-size: 14px;
        }


        /* ==================================================
           THÔNG TIN GVCN
        ================================================== */

        .teacher-info-grid {

            display: grid;

            grid-template-columns:
                repeat(
                    4,
                    minmax(0, 1fr)
                );

            gap: 14px;
        }


        .info-box {

            min-width: 0;

            padding:
                17px
                18px;

            border:
                1px solid
                #e2e7ed;

            border-radius: 11px;

            background: #fafbfc;
        }


        .info-label {

            margin-bottom: 7px;

            color: #737f91;

            font-size: 13px;

            font-weight: 600;
        }


        .info-value {

            color: #151d2c;

            font-size: 15px;

            font-weight: 600;

            overflow-wrap: anywhere;
        }


        .status-badge {

            display: inline-flex;

            align-items: center;

            padding:
                5px
                10px;

            border-radius: 999px;

            background: #def3e8;

            color: #26704d;

            font-size: 12px;

            font-weight: 600;
        }


        /* ==================================================
           TỔNG QUAN
        ================================================== */

        .summary-grid {

            display: grid;

            grid-template-columns:
                repeat(
                    2,
                    minmax(0, 1fr)
                );

            gap: 14px;

            margin-bottom: 20px;
        }


        .summary-box {

            padding:
                16px
                18px;

            border:
                1px solid
                #e3e8ee;

            border-radius: 11px;

            background: #fafbfc;
        }


        .summary-number {

            display: block;

            margin-bottom: 3px;

            color: #df3545;

            font-size: 23px;

            font-weight: 700;
        }


        .summary-label {

            color: #6f7a8c;

            font-size: 13px;
        }


        /* ==================================================
           DANH SÁCH LỚP
        ================================================== */

        .class-grid {

            display: grid;

            grid-template-columns:
                repeat(
                    3,
                    minmax(0, 1fr)
                );

            gap: 16px;
        }


        .class-card {

            display: flex;

            flex-direction: column;

            min-width: 0;

            min-height: 230px;

            padding:
                20px;

            border:
                1px solid
                #dfe5ec;

            border-radius: 13px;

            background: #fafbfc;

            transition:
                border-color 0.2s,
                background 0.2s,
                transform 0.2s;
        }


        .class-card:hover {

            border-color: #cfd7e1;

            background: #ffffff;

            transform:
                translateY(-1px);
        }


        .class-card-top {

            display: flex;

            justify-content:
                space-between;

            align-items: flex-start;

            gap: 12px;

            margin-bottom: 18px;
        }


        .class-code {

            margin: 0;

            color: #182033;

            font-size: 22px;

            font-weight: 700;
        }


        .student-count {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding:
                5px
                9px;

            border-radius: 999px;

            background: #e9edf3;

            color: #4e5c70;

            font-size: 12px;

            font-weight: 600;

            white-space: nowrap;
        }


        .class-detail {

            display: grid;

            gap: 10px;

            margin-bottom: 22px;
        }


        .class-detail-row {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            gap: 12px;

            font-size: 14px;
        }


        .class-detail-label {

            color: #727e90;
        }


        .class-detail-value {

            color: #182033;

            font-weight: 600;

            text-align: right;
        }


        .active-badge {

            display: inline-flex;

            align-items: center;

            padding:
                4px
                9px;

            border-radius: 999px;

            background: #def3e8;

            color: #26704d;

            font-size: 12px;

            font-weight: 600;
        }


        .class-button {

            width: 100%;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-height: 42px;

            margin-top: auto;

            padding:
                10px
                14px;

            border-radius: 9px;

            background: #df3545;

            color: #ffffff;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            transition: 0.2s;
        }


        .class-button:hover {

            background: #c82d3c;
        }


        /* ==================================================
           KHÔNG CÓ LỚP
        ================================================== */

        .empty-class {

            padding:
                28px
                20px;

            border:
                1px dashed
                #d7dee7;

            border-radius: 11px;

            background: #fafbfc;

            text-align: center;

            color: #748094;
        }


        /* ==================================================
           GHI CHÚ QUYỀN HẠN
        ================================================== */

        .permission-note {

            padding:
                17px
                19px;

            border-left:
                4px solid
                #f0b323;

            border-radius: 8px;

            background: #fff5d7;

            color: #745814;

            line-height: 1.65;

            font-size: 14px;
        }


        /* ==================================================
           RESPONSIVE
        ================================================== */

        @media (
            max-width: 900px
        ) {

            .teacher-info-grid {

                grid-template-columns:
                    repeat(
                        2,
                        minmax(0, 1fr)
                    );
            }


            .class-grid {

                grid-template-columns:
                    1fr;
            }

        }


        @media (
            max-width: 600px
        ) {

            .teacher-container {

                width:
                    calc(
                        100% - 24px
                    );

                padding-top: 18px;
            }


            .teacher-header {

                align-items:
                    flex-start;
            }


            .teacher-header-text h1 {

                font-size: 23px;
            }


            .logout-button {

                padding:
                    9px
                    12px;

                font-size: 13px;
            }


            .section-card {

                padding: 18px;
            }


            .teacher-info-grid,
            .summary-grid {

                grid-template-columns:
                    1fr;
            }

        }

    </style>

</head>


<body class="teacher-page">


    <main class="teacher-container">


        <!-- ==================================================
             HEADER
        ================================================== -->

        <header class="teacher-header">


            <div class="teacher-header-text">

                <h1>
                    Giáo viên chủ nhiệm
                </h1>

                <p>
                    Theo dõi tiến độ học tập
                    và cảnh báo của sinh viên
                    thuộc các lớp được phân công.
                </p>

            </div>


            <a
                href="/logout"
                class="logout-button"
            >
                Đăng xuất
            </a>


        </header>


        <!-- ==================================================
             THÔNG TIN GVCN
        ================================================== -->

        <section class="section-card">


            <h2 class="section-title">
                Thông tin GVCN
            </h2>


            <p class="section-description">
                Thông tin tài khoản đang đăng nhập.
            </p>


            <div class="teacher-info-grid">


                <div class="info-box">

                    <div class="info-label">
                        Họ và tên
                    </div>

                    <div class="info-value">
                        <%= giaoVien.hoTen %>
                    </div>

                </div>


                <div class="info-box">

                    <div class="info-label">
                        Tên đăng nhập
                    </div>

                    <div class="info-value">
                        <%= giaoVien.tenDangNhap %>
                    </div>

                </div>


                <div class="info-box">

                    <div class="info-label">
                        Vai trò
                    </div>

                    <div class="info-value">
                        Giáo viên chủ nhiệm
                    </div>

                </div>


                <div class="info-box">

                    <div class="info-label">
                        Trạng thái tài khoản
                    </div>


                    <% if (giaoVien.trangThai) { %>

                        <span class="status-badge">
                            Đang hoạt động
                        </span>

                    <% } else { %>

                        <span
                            class="status-badge"
                            style="
                                background:#fde1e5;
                                color:#b62f3d;
                            "
                        >
                            Đã khóa
                        </span>

                    <% } %>

                </div>


            </div>


        </section>


        <!-- ==================================================
             LỚP ĐƯỢC PHÂN CÔNG
        ================================================== -->

        <section class="section-card">


            <h2 class="section-title">
                Lớp được phân công
            </h2>


            <p class="section-description">
                Chọn một lớp để xem,
                lọc và theo dõi sinh viên.
            </p>


            <!-- ==============================================
                 TỔNG QUAN NHANH
            =============================================== -->

            <div class="summary-grid">


                <div class="summary-box">

                    <span class="summary-number">
                        <%= tongLop %>
                    </span>

                    <span class="summary-label">
                        Lớp đang phụ trách
                    </span>

                </div>


                <div class="summary-box">

                    <span class="summary-number">
                        <%= tongSinhVien %>
                    </span>

                    <span class="summary-label">
                        Tổng sinh viên đang theo dõi
                    </span>

                </div>


            </div>


            <% if (
                danhSachPhanCong &&
                danhSachPhanCong.length > 0
            ) { %>


                <div class="class-grid">


                    <% danhSachPhanCong.forEach(
                        phanCong => {
                    %>


                        <article class="class-card">


                            <div class="class-card-top">


                                <h3 class="class-code">
                                    <%= phanCong.maLop %>
                                </h3>


                                <span class="student-count">

                                    <%= phanCong.soSinhVien %>
                                    sinh viên

                                </span>


                            </div>


                            <div class="class-detail">


                                <div class="class-detail-row">

                                    <span class="class-detail-label">
                                        Năm học
                                    </span>

                                    <span class="class-detail-value">
                                        <%= phanCong.namHoc %>
                                    </span>

                                </div>


                                <div class="class-detail-row">

                                    <span class="class-detail-label">
                                        Trạng thái
                                    </span>

                                    <span class="active-badge">
                                        Đang phụ trách
                                    </span>

                                </div>


                            </div>


                            <a
                                href="/giangvien/sinhvien?maLop=<%= encodeURIComponent(phanCong.maLop) %>"
                                class="class-button"
                            >
                                Xem sinh viên
                            </a>


                        </article>


                    <% }); %>


                </div>


            <% } else { %>


                <div class="empty-class">

                    Giáo viên hiện chưa được
                    phân công lớp nào.

                </div>


            <% } %>


        </section>


        <!-- ==================================================
             PHẠM VI QUYỀN HẠN
        ================================================== -->

        <section class="section-card">


            <h2 class="section-title">
                Phạm vi quyền hạn
            </h2>


            <p class="section-description">
                Quyền sử dụng của giáo viên chủ nhiệm.
            </p>


            <div class="permission-note">

                GVCN được xem sinh viên thuộc
                các lớp đang được phân công,
                theo dõi tiến độ học tập,
                học phần chưa đạt và cảnh báo học tập.

                <br><br>

                GVCN không thêm, sửa hoặc xóa
                kết quả học tập, chương trình đào tạo
                hay dữ liệu học phần của sinh viên.

            </div>


        </section>


    </main>


</body>

</html>